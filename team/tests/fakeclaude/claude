#!/usr/bin/env python3
"""Stand-in for Claude Code: records how it was started, then acts like Tim claiming an issue."""
import json, os, subprocess, sys
rec = {"argv": sys.argv[1:], "cwd": os.getcwd(),
       "env": {k: os.environ.get(k) for k in ("GH_TOKEN", "WATCHTOWER_AGENT", "CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_CODE_SIMPLE", "ANTHROPIC_BASE_URL")}}
open(os.environ["FAKE_CLAUDE_LOG"], "w").write(json.dumps(rec))
r = subprocess.run([sys.executable, "team/team.py", "comment", "--as", "tim-drake", "--on", "7", "--body", "Picked up. Branch: feat/7-export."])
tok = subprocess.run([sys.executable, "team/team.py", "token", "--as", "barbara-gordon"], capture_output=True, text=True)
open(os.environ["FAKE_CLAUDE_LOG"] + ".token", "w").write(f"{tok.returncode}\n{tok.stderr}")
sys.exit(r.returncode)
