{
  "_comment": "Copy to ~/.watchtower/agents.json and edit. One entry per member. {prompt} is replaced with the check-in instruction. workdir defaults to the clone watch.sh runs from. Check each flag against your installed CLI version.",

  "tim-drake": {
    "workdir": "~/code/PROJECT-tim",
    "timeout_minutes": 90,
    "command": ["claude", "-p", "{prompt}", "--model", "claude-opus-5-5",
                "--allowedTools", "Bash(git:*) Bash(gh:*) Bash(make:*) Bash(python3 team/team.py:*) Read Edit Write Glob Grep"]
  },

  "barbara-gordon": {
    "workdir": "~/code/PROJECT-review",
    "command": ["gemini", "-m", "gemini-3.1-pro-preview", "--approval-mode", "yolo", "-p", "{prompt}"]
  },
  "lucius-fox": {
    "workdir": "~/code/PROJECT-review",
    "command": ["gemini", "-m", "gemini-3.1-pro-preview", "--approval-mode", "yolo", "-p", "{prompt}"]
  },
  "bruce-wayne": {
    "workdir": "~/code/PROJECT-review",
    "command": ["gemini", "-m", "gemini-3.1-pro-preview", "--approval-mode", "yolo", "-p", "{prompt}"]
  },
  "victor-stone": {
    "workdir": "~/code/PROJECT-review",
    "command": ["gemini", "-m", "gemini-3.8-flash", "--approval-mode", "yolo", "-p", "{prompt}"]
  }
}
